{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387

    "version": "0.2.0",
    
    // 可配置多个调试方案，这里只放一个 C(gdb) 方案
    "configurations": [
        { 
            // 调试器下拉列表里显示的名称
            "name": "C 调试 (gdb)",    
            
            // C/C++ 扩展的调试类型（微软 C/C++ 扩展）
            "type": "cppdbg",
            
            // 调试请求类型：
            // launch = 启动一个新进程进行调试
            // attach = 附加到已运行进程
            "request": "launch",

            // 要调试的可执行文件路径
            // 与 tasks.json 的 -o 输出保持一致：
            // 例如 /path/test.c -> /path/test
            "program": "${fileDirname}/CompiledFiles/${fileBasenameNoExtension}",

            // 传给程序的命令行参数（按需添加）
            // 示例：["arg1", "arg2"]
            "args": [],

            // 是否在程序入口处暂停
            // true: 一启动就停在 main 前后
            // false: 直接运行到断点
            "stopAtEntry": false,

            // 调试进程工作目录（程序相对路径基准）
            "cwd": "${fileDirname}",

            // 传给被调试程序的环境变量
            // 示例：[{ "name": "MODE", "value": "dev" }]
            "environment": [],

            // false: 使用 VS Code 内置调试控制台/终端
            // true: 额外弹出外部终端窗口
            "externalConsole": false,

            // MI 调试后端模式，gdb/lldb 二选一
            "MIMode": "gdb",

            // gdb 可执行文件路径（Linux 常见路径）
            "miDebuggerPath": "/usr/bin/gdb",

            // 启动调试前先执行的任务（必须与 tasks.json 的 label 对应）
            "preLaunchTask": "build-c",

            // 调试器初始化命令
            "setupCommands": [
                {
                    // 描述文字，仅用于可读性
                    "description": "启用 gdb pretty printing",

                    // 发送给 gdb 的命令
                    "text": "-enable-pretty-printing",

                    // 命令失败是否忽略（一般设 true，避免影响启动）
                    "ignoreFailures": true
                }
            ]
        }
    ]
    // ...existing code...
}